generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Simulation {
  id            String        @id
  ownerId       String?
  name          String
  createdAt     DateTime
  startMonth    String
  horizonMonths Int?
  budgets       MonthBudget[]
  debts         DebtItem[]
  owner         User?         @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("Simulation")
}

model User {
  id           String       @id
  email        String       @unique
  passwordHash String
  createdAt    DateTime
  simulations  Simulation[]

  @@map("User")
}

model MonthBudget {
  id           String     @id @default(cuid())
  simulationId String
  month        Int
  year         Int
  initialValue Decimal    @db.Decimal(14, 2)
  simulation   Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@unique([simulationId, year, month])
  @@index([simulationId])
  @@map("MonthBudget")
}

model DebtItem {
  id                    String     @id
  simulationId          String
  name                  String
  netAmount             Decimal    @db.Decimal(14, 2)
  installments          Int
  startMonth            String
  creditInPreviousMonth Boolean    @default(false)
  creditMonth           String?
  active                Boolean    @default(true)
  createdAt             DateTime
  simulation            Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@index([simulationId])
  @@map("DebtItem")
}

model AppSettings {
  id        String   @id
  fees      Json
  updatedAt DateTime @updatedAt

  @@map("AppSettings")
}
